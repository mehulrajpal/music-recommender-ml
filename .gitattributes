# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files to always be normalized and diffed as LF
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf

# Jupyter notebooks: treat as text for diffing, but large outputs can bloat
# diffs -- consider clearing outputs before committing if they grow large.
*.ipynb text eol=lf

# Trained model artifacts and datasets are binary/opaque -- don't diff them as text
*.pkl binary
*.joblib binary
*.csv text eol=lf diff=csv

# Denote notebooks as a generated/vendored-style diff to keep PR diffs cleaner on GitHub
*.ipynb linguist-generated=false
